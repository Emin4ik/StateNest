{
  "name": "statenest",
  "version": "0.2.0",
  "description": "Local-first project memory and developer control plane: remembers your projects, machines, deployments and where you left off, and hands that context to your coding agent.",
  "keywords": [
    "cli",
    "developer-tools",
    "project-memory",
    "project-management",
    "coding-agent",
    "ai-agents",
    "claude-code",
    "mcp",
    "local-first",
    "git"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emin4ik/StateNest.git"
  },
  "homepage": "https://github.com/Emin4ik/StateNest#readme",
  "bugs": {
    "url": "https://github.com/Emin4ik/StateNest/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "statenest": "dist/cli/bin.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-plugin",
    "schemas",
    ".claude-plugin",
    ".mcp.json",
    "skills",
    "hooks",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/build-plugin.mjs",
    "!dist/mcp",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-plugin.mjs",
    "clean": "node -e \"const f=require('node:fs');for(const d of ['dist','dist-plugin','coverage'])f.rmSync(d,{recursive:true,force:true})\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:bytes": "node scripts/check-source-bytes.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:bytes && npm run build && npm test",
    "schemas": "node scripts/generate-schemas.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "metadata:sync": "node scripts/sync-metadata.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "bench": "node scripts/benchmark.mjs",
    "demo": "node scripts/demo.mjs",
    "readme:published": "node scripts/readme-published.mjs",
    "release:check": "npm run verify && npm run check:schemas && npm run verify:package && npm run check:metadata"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
